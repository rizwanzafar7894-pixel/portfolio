rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null;}
  function admin(){return signedIn() && request.auth.token.admin == true;}
  function publicMessage(){return request.resource.data.keys().hasOnly(['name','email','message','status','projectType','budget','timeline','details','source','createdAt','updatedAt']) && request.resource.data.name is string && request.resource.data.email is string && request.resource.data.message is string && request.resource.data.status == 'new';}
  function subscriber(){return request.resource.data.keys().hasOnly(['email','createdAt','source']) && request.resource.data.email is string;}
  match /projects/{id}{allow read:if resource.data.published==true||admin();allow write:if admin();}
  match /posts/{id}{allow read:if resource.data.published==true||admin();allow write:if admin();}
  match /services/{id}{allow read:if resource.data.published==true||admin();allow write:if admin();}
  match /skills/{id}{allow read:if resource.data.published==true||admin();allow write:if admin();}
  match /tools/{id}{allow read:if resource.data.published==true||admin();allow write:if admin();}
  match /pricingPlans/{id}{allow read:if resource.data.published==true||admin();allow write:if admin();}
  match /testimonials/{id}{allow read:if resource.data.published==true||admin();allow write:if admin();}
  match /faqs/{id}{allow read:if resource.data.published==true||admin();allow write:if admin();}
  match /siteSettings/{id}{allow read:if id == 'public';allow write:if admin();}
  match /media/{id}{allow read:if true;allow write:if admin();}
  match /adminActivity/{id}{allow read,write:if admin();}
  match /contactMessages/{id}{allow create:if publicMessage();allow read,update,delete:if admin();}
  match /hireRequests/{id}{allow create:if publicMessage();allow read,update,delete:if admin();}
  match /newsletterSubscribers/{id}{allow create:if subscriber();allow read,update,delete:if admin();}
  match /{document=**}{allow read,write:if false;}
 }
}
